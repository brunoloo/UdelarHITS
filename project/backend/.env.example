# Copiar a .env y completar. Ningún valor de este archivo es real.

# Servidor
NODE_ENV=development
PORT=5001
# "true" responde 503 en todas las rutas salvo /health, sin tocar la base.
MAINTENANCE_MODE=false

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=udelarhits
DB_USER=
DB_PASSWORD=

# URLs
# Orígenes permitidos por CORS, separados por coma.
URL=http://localhost:5173
# Base pública para URLs canónicas, sitemap y previews.
SITE_URL=http://localhost:5173
# Base de los enlaces que se envían por correo.
APP_URL=http://localhost:5173
# Destino tras el login con Google.
FRONTEND_URL=http://localhost:5173

# Sesión. Generar el secreto con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Imágenes y adjuntos (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo (Resend)
RESEND_API_KEY=
RESEND_FROM=UdelarHITS <no-reply@example.com>

# Login con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Moderación automática de imágenes (opcional). Sin clave queda desactivada.
GOOGLE_VISION_API_KEY=
# Horas que una imagen puede esperar revisión antes de descartarse.
IMAGE_REVIEW_EXPIRY_HOURS=48

# Notificaciones push (opcional). Generar el par con: npx web-push generate-vapid-keys
# Cambiar las claves invalida las suscripciones existentes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@example.com

# Moderación por reportes (opcional; valores por defecto en src/config/reportConfig.js)
UMBRAL_FACTOR_PARTICIPANTES=
UMBRAL_MIN_PARTICIPANTES=
UMBRAL_MAX_PARTICIPANTES=
UMBRAL_VISITANTE_MIN=
UMBRAL_VISITANTE_MULT=
UMBRAL_HOME=

# Ranking (opcional; ver src/config/trendingConfig.js y src/config/feedConfig.js)
TRENDING_HALF_LIFE_HOURS=
FEED_UMBRAL_CUENTAS=
FEED_UMBRAL_ANCHO=
FEED_UMBRAL_TTL_SEG=
FEED_VISITA_TTL_HORAS=
# Fuerza la intensidad del ranking (0 a 1). Vacío: automática.
FEED_INTENSIDAD_FORZADA=

# Límites operativos (opcional)
CHAT_MAX_ACTIVE_CONVERSATIONS=
CHAT_ACTIVE_TTL_MS=
CHAT_RETENTION_DAYS=
NOTIF_RT_PAUSE_THRESHOLD=
NOTIF_RT_RESUME_THRESHOLD=
FORGOT_PASSWORD_ACCOUNT_WINDOW_MS=
