# Copiar a .env.test. El entorno de test se define solo con este archivo y nunca
# lee .env. Ninguna credencial puede ser real: tests/load-env.js aborta la suite
# si detecta una base que no sea de test o claves de servicios externos.

NODE_ENV=test

# Base local cuyo nombre contenga "test": la suite trunca todas las tablas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=udelarhits_test
DB_USER=
DB_PASSWORD=

PORT=5001
URL=http://localhost:5173
SITE_URL=http://localhost:5173
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

JWT_SECRET=test_jwt_secret_no_usar_en_produccion
JWT_EXPIRES_IN=7d

# Los servicios externos no se llaman en test; estos valores son de relleno.
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test
RESEND_API_KEY=test
RESEND_FROM=UdelarHITS Test <test@example.com>
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Deben quedar vacías.
GOOGLE_VISION_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

IMAGE_REVIEW_EXPIRY_HOURS=
UMBRAL_FACTOR_PARTICIPANTES=
UMBRAL_MIN_PARTICIPANTES=
UMBRAL_MAX_PARTICIPANTES=
UMBRAL_VISITANTE_MIN=
UMBRAL_VISITANTE_MULT=
UMBRAL_HOME=
TRENDING_HALF_LIFE_HOURS=
FEED_UMBRAL_CUENTAS=300
FEED_UMBRAL_ANCHO=50
FEED_UMBRAL_TTL_SEG=600
FEED_VISITA_TTL_HORAS=6
FEED_INTENSIDAD_FORZADA=
MAINTENANCE_MODE=false
CHAT_MAX_ACTIVE_CONVERSATIONS=
CHAT_ACTIVE_TTL_MS=
NOTIF_RT_PAUSE_THRESHOLD=
NOTIF_RT_RESUME_THRESHOLD=
CHAT_RETENTION_DAYS=
FORGOT_PASSWORD_ACCOUNT_WINDOW_MS=
