# ============================================================================
# .env.test.example — plantilla del entorno de TEST (copiar a .env.test)
# ============================================================================
# El entorno de test debe ser AUTOCONTENIDO: define TODA variable que la app
# lee, con valores de test. Nunca hereda nada del `.env` de desarrollo.
#
# Por qué existe: antes `.env.test` definía solo un subconjunto de variables y
# db.js/server.js rellenaban el resto desde `.env` (dev/producción) vía un
# dotenv.config() suelto. Eso filtraba credenciales reales a la suite —
# incluida GOOGLE_VISION_API_KEY, que hacía que los tests pegaran a la API de
# Google de verdad y consumieran cuota. Ver tests/load-env.js y src/config/env.js.
#
# Regla: ninguna credencial de acá puede ser real. Los servicios externos están
# cortocircuitados en test (NODE_ENV==='test' en uploadToCloudinary, sendEmail y
# checkImageSafety), pero igual usamos valores dummy como defensa en profundidad.
# tests/load-env.js aborta la suite si detecta credenciales que parezcan de
# producción (ver el guard ahí).
# ============================================================================

# Fuerza el modo test (además Jest ya lo fija por defecto).
NODE_ENV=test

# --- Base de datos: SIEMPRE local y con "test" en el nombre --------------------
# setup.js aborta el TRUNCATE si DB_NAME no incluye "test"; el guard de
# load-env.js aborta si DB_HOST apunta a un host remoto (Supabase, RDS, etc.).
# Debe coincidir con los scripts npm run db:test:* (DB local udelarhits_test).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=udelarhits_test
DB_USER=
DB_PASSWORD=

# --- Puerto / URLs (no se pega a nada, son solo strings) -----------------------
PORT=5001
URL=http://localhost:5173
SITE_URL=http://localhost:5173
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Cloudinary: DUMMY (uploadToCloudinary corta en test, nunca sube) ----------
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test

# --- JWT: secreto fijo de test (NO el de producción) ---------------------------
JWT_SECRET=test_jwt_secret_no_usar_en_produccion
JWT_EXPIRES_IN=7d

# --- Resend (email): DUMMY (sendEmail corta en test, nunca envía) --------------
RESEND_API_KEY=test
RESEND_FROM=UdelarHITS Test <test@example.com>

# --- Google OAuth: DUMMY (no son credenciales reales) -------------------------
# Con estas presentes passport registra la estrategia y el endpoint
# GET /api/auth/google construye el 302 a accounts.google.com. Armar esa URL de
# autorización es construcción de string pura: NO hay llamada a Google ni se
# valida el client_id hasta que un usuario aterriza en su pantalla (algo que la
# suite nunca alcanza). Así el test ejercita el flujo OAuth real sin credenciales
# de producción ni tráfico externo.
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# --- Google Cloud Vision: VACÍO. Con key vacía la moderación queda desactivada;
# además checkImageSafety corta en test. NUNCA poner una key real acá.
GOOGLE_VISION_API_KEY=
IMAGE_REVIEW_EXPIRY_HOURS=

# --- Trending / reportes (tienen defaults; se listan para que el test sea
# reproducible e independiente del `.env` de dev) ------------------------------
UMBRAL_FACTOR_PARTICIPANTES=
UMBRAL_MIN_PARTICIPANTES=
UMBRAL_MAX_PARTICIPANTES=
UMBRAL_VISITANTE_MIN=
UMBRAL_VISITANTE_MULT=
UMBRAL_HOME=
TRENDING_HALF_LIFE_HOURS=

# --- Modo mantenimiento -------------------------------------------------------
MAINTENANCE_MODE=false

# --- Defensas de infraestructura ----------------------------------------------
CHAT_MAX_ACTIVE_CONVERSATIONS=
CHAT_ACTIVE_TTL_MS=
NOTIF_RT_PAUSE_THRESHOLD=
NOTIF_RT_RESUME_THRESHOLD=
CHAT_RETENTION_DAYS=
# La suite testea el límite de recuperación de contraseña, así que suele
# sobreescribirse por test; el default de 24hs va bien como base.
FORGOT_PASSWORD_ACCOUNT_WINDOW_MS=
